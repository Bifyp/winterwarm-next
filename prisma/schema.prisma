// Educational database scaffold. The website does NOT currently query these tables.
// Catalog remains in content/site-data.json; the existing API does not save inquiries here.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InquiryStatus {
  PENDING
  EMAIL_ACCEPTED
  EMAIL_FAILED
}

model Category {
  slug      String    @id @db.VarChar(32)
  name      String    @db.VarChar(80)
  sortOrder Int       @default(0) @map("sort_order")
  products  Product[]

  @@map("categories")
}

model Product {
  id             String   @id @db.VarChar(64)
  name           String   @db.VarChar(180)
  description    String   @db.Text
  groupName      String   @map("group_name") @db.VarChar(80)
  imagePath      String   @map("image_path") @db.VarChar(500)
  destinationUrl String   @map("destination_url") @db.VarChar(1000)
  categorySlug   String   @map("category_slug") @db.VarChar(32)
  category       Category @relation(fields: [categorySlug], references: [slug], onDelete: Restrict)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([categorySlug, active, sortOrder])
  @@map("products")
}

// Planned storage only: not wired to /api/contact and contains no submitted data.
model Inquiry {
  id                String        @id @default(uuid()) @db.Uuid
  contactName       String        @map("contact_name") @db.VarChar(150)
  contactEmail      String        @map("contact_email") @db.VarChar(200)
  needs             String[]
  objectType        String        @map("object_type") @db.VarChar(100)
  stage             String        @db.VarChar(80)
  areaM2            Decimal?      @map("area_m2") @db.Decimal(12, 2)
  location          String?       @db.VarChar(100)
  details           String?       @db.Text
  consentAt         DateTime      @map("consent_at") @db.Timestamptz(3)
  status            InquiryStatus @default(PENDING)
  providerMessageId String?       @map("provider_message_id") @db.VarChar(200)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("inquiries")
}
