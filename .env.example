# Public canonical URL. No trailing path; HTTPS for production.
SITE_URL=https://your-domain.example
# Enable only after production approval. Preview deployments stay noindex.
SITE_INDEXABLE=false
# Enable only AFTER privacy/copy approval, keys and inbox tests.
CONTACT_ENABLED=false

# Resend: verify your sender domain. Never use a visitor address as FROM.
RESEND_API_KEY=
CONTACT_FROM=Winterwarm Website <website@your-domain.example>
CONTACT_TO=
# Optional departmental overrides; fallback is CONTACT_TO.
CONTACT_TO_HVAC=
CONTACT_TO_ACCESS=
CONTACT_TO_LED=

# Persistent cross-instance fixed-window limit (5 attempts / 10 min).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random stable secret: openssl rand -hex 32
RATE_LIMIT_SALT=

# Cloudflare Turnstile. Restrict hostnames in its dashboard.
# Site key is public and injected at BUILD time; secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
